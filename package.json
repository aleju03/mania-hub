{
  "name": "demo-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#dan/*": "./live-backend/src/dan/*",
    "#leoblack/*": "./live-backend/vendor/leoblack/*"
  },
  "scripts": {
    "postinstall": "node scripts/prune-onnxruntime-web.mjs",
    "dev": "vite dev --port 3000",
    "dev:all": "node scripts/dev/run-dev-stack.mjs",
    "dev:all:host": "node scripts/dev/run-dev-stack.mjs --host",
    "build": "node scripts/build-replay-hitsound-bundle.mjs && vite build && node scripts/verify-build-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "dan:analyze": "vite-node scripts/dan-analyze.ts",
    "dan:benchmark": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs scripts/dan-benchmark.ts",
    "validate:mania-sr": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs scripts/validate-mania-sr.ts",
    "validate:mania-pp": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs scripts/validate-mania-pp.ts",
    "live-db:sync-from-vps": "npm --prefix live-backend run db:sync-from-vps --",
    "live-db:update": "npm --prefix live-backend run db:sync-from-vps -- --fresh",
    "replay:capture-stable": "node --env-file-if-exists=.env scripts/replay-capture-stable.ts",
    "replay:compare-capture": "node --env-file-if-exists=.env scripts/replay-compare-capture.ts",
    "replay:convert-capture": "node scripts/replay-capture-convert.mjs",
    "replay:source-audit": "node --env-file-if-exists=.env scripts/stable-replay-source-audit.ts",
    "replay:validate": "node --env-file-if-exists=.env scripts/replay-validate.ts",
    "replay:build-hitsounds": "node scripts/build-replay-hitsound-bundle.mjs",
    "skins:build-preview-backdrops": "node scripts/build-skin-preview-backdrops.mjs",
    "regions:build-icons": "node scripts/generate-region-icons.ts",
    "audio:migrate-playback": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs scripts/migrate-audio-playback-cache.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.13.23",
    "@tanstack/router-plugin": "^1.132.0",
    "@vercel/functions": "^3.4.3",
    "@vercel/og": "^0.11.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "lzma-js-simple-v2": "^1.2.3",
    "lzma-purejs": "^0.9.3",
    "mediabunny": "^1.50.6",
    "nitro": "^3.0.260311-beta",
    "onnxruntime-web": "^1.27.0",
    "osu-parsers": "^4.1.7",
    "page-flip": "^2.0.7",
    "pixi.js": "^8.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "sharp": "^0.35.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
