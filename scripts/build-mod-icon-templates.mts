// Bakes lazer's mod glyphs into the masks the Discord bot matches score
// screenshots against (backend/src/discord/mod-icons.ts). Each glyph SVG in
// public/images/badges/mods is drawn on its 120x84 plate canvas, the same
// plate the game draws, and kept as a 1-bit mask at MASK_W x MASK_H with the
// plate colour of its mod type.
//
// Run from the repo root:  npx tsx scripts/build-mod-icon-templates.mts
// Re-run after adding or redrawing a mod glyph.

import { readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import sharp from "sharp";
import { MOD_BADGE_FILE_NAMES, MOD_BADGE_TYPE_COLORS } from "../src/components/ui/ModBadge.tsx";

const ROOT = join(import.meta.dirname, "..");
const MOD_DIR = join(ROOT, "public/images/badges/mods");
const OUT = join(ROOT, "backend/src/discord/mod-icon-templates.ts");
const MASK_W = 60;
const MASK_H = 42;

const templates: Array<{ mod: string; color: string; mask: string }> = [];
for (const [mod, file] of Object.entries(MOD_BADGE_FILE_NAMES)) {
  const color = MOD_BADGE_TYPE_COLORS[mod];
  if (!color) continue;
  let svg: Buffer;
  try {
    svg = await readFile(join(MOD_DIR, `mod-${file}.svg`));
  } catch {
    continue;
  }
  const { data } = await sharp(svg, { density: 144 }).resize(MASK_W, MASK_H, { fit: "fill" }).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  const bits = new Uint8Array(Math.ceil((MASK_W * MASK_H) / 8));
  for (let i = 0; i < MASK_W * MASK_H; i += 1) {
    if (data[i * 4 + 3] > 100 && data[i * 4] > 128) bits[i >> 3] |= 1 << (i & 7);
  }
  templates.push({ mod, color, mask: Buffer.from(bits).toString("base64") });
}

const rows = templates.map((t) => `  { mod: ${JSON.stringify(t.mod)}, color: ${JSON.stringify(t.color)}, mask: ${JSON.stringify(t.mask)} },`).join("\n");
await writeFile(OUT, `// Generated by scripts/build-mod-icon-templates.mts in the site repo; do not edit.
export const MOD_MASK_W = ${MASK_W};
export const MOD_MASK_H = ${MASK_H};
export const MOD_ICON_TEMPLATES: ReadonlyArray<{ mod: string; color: string; mask: string }> = [
${rows}
];
`);
console.log(`Wrote ${templates.length} mod glyph masks to ${OUT}`);
