# Frontend/server-function secrets. Not exhaustive — see CLAUDE.md and
# live-backend/.env.example for the full picture.

# osu! OAuth app (server-side only; never exposed to the client).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Cookie-signing secret, at least 32 characters. Falls back to OSU_CLIENT_SECRET when unset.
AUTH_SESSION_SECRET=

# Discord OAuth app, used only by /communities to prove someone runs the server
# they are listing (scopes: identify, guilds). Nobody signs in to the site with
# Discord and no Discord token is stored. The client id is the bot's application
# id; the secret comes from the same app in the Discord developer portal, where
# /api/auth/discord/callback has to be registered as a redirect URI for every
# host that serves the site.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Live backend link. VITE_LIVE_BACKEND_URL is the browser-facing origin;
# LIVE_BACKEND_URL is the server-to-server origin.
VITE_LIVE_BACKEND_URL=http://localhost:7227
LIVE_BACKEND_URL=http://localhost:7227
# Must match LIVE_ADMIN_TOKEN in live-backend/.env. The backend fails closed:
# without it, admin endpoints return 401 even in local development.
LIVE_ADMIN_TOKEN=
# The per-user server-to-server credential: goals, my-data, packs, skins
# ownership, roster opt-in, the osu! proxies, analytics capture. Those calls say
# "this came from my own server" and carry the osu!-verified viewer id in the
# payload, which is a different claim from "this may do admin things" - one
# token for both meant a leak of it could write as any player on the site.
# Leave it blank and the bridge is the admin token, exactly as before. To split
# them, set a different value here AND the same value as LIVE_BRIDGE_TOKEN in
# live-backend/.env, in one deploy: setting only one side answers 401 to every
# signed-in feature.
LIVE_BRIDGE_TOKEN=

# The frontend Request object has no socket peer address. Enable this only when
# the origin rejects direct traffic and every request comes through Cloudflare,
# which overwrites cf-connecting-ip. When false/unset, frontend rate limiters
# deliberately share one "unknown" bucket and ignore all caller-supplied IP
# headers. x-real-ip and x-forwarded-for are never trusted here.
TRUST_PROXY_HEADERS=false

# Explicit local-development switch: grants admin/dev features to loopback
# requests when NODE_ENV is not production. NODE_ENV alone no longer grants
# admin. Set to 1 locally; never set in production.
ENABLE_LOCAL_DEV_ADMIN=1
