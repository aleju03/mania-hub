# Frontend / server functions. The live backend has its own file at
# live-backend/.env.example.

# osu! OAuth app (server-side only).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Cookie-signing secret, at least 32 characters. Defaults to OSU_CLIENT_SECRET.
AUTH_SESSION_SECRET=

# Discord OAuth app, used by /communities (scopes: identify, guilds).
# Register /api/auth/discord/callback as a redirect URI for every host.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Live backend origins: browser-facing and server-to-server.
VITE_LIVE_BACKEND_URL=http://localhost:7227
LIVE_BACKEND_URL=http://localhost:7227
# Must match the backend's LIVE_ADMIN_TOKEN; admin endpoints 401 without it.
LIVE_ADMIN_TOKEN=
# Per-user server-to-server credential. Blank falls back to LIVE_ADMIN_TOKEN;
# when set it must match the backend's LIVE_BRIDGE_TOKEN.
LIVE_BRIDGE_TOKEN=

# Shows the on-device replay video export button to everyone. Export runs
# entirely in the browser; this does not enable any backend endpoint.
VITE_ENABLE_LOCAL_REPLAY_VIDEO_EXPORT=0

# Trust cf-connecting-ip for rate limiting. Only enable behind Cloudflare.
TRUST_PROXY_HEADERS=false

# Grant admin/dev features to loopback requests outside production.
ENABLE_LOCAL_DEV_ADMIN=1

# Cloudflare cache purge for dynamic renders (optional). Token needs
# Zone -> Cache Purge.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Uploaded replays go to R2 in production and data/replay-uploads/ locally.
# REPLAY_UPLOADS_TO_R2=1
