PORT=7227
NODE_ENV=development
DATABASE_URL=file:./data/mania-hub-live.db
DATABASE_AUTH_TOKEN=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSC_BASE_URL=https://osc.kaysting.dev
OSC_SOCKET_PATH=/ws
TRACKED_COUNTRIES=CR
ENABLE_WORKERS=true
ENABLE_OSU_API_JOBS=true
ENABLE_STARTUP_ROSTER_REFRESH=true
ENABLE_SCHEDULED_REFRESHES=true
ENABLE_OSC_BACKFILL=false
ENABLE_OSC_SOCKET=true
ENABLE_OSU_SCORES_FALLBACK=true
LIVE_PUBLIC_ORIGIN=http://localhost:7227
ALLOWED_ORIGINS=http://localhost:3000,https://mania-tracker.com,https://www.mania-tracker.com
# Secret for the admin endpoints (/api/admin/*, the analytics queries, the
# destructive actions) and the key the ghost overlay signs viewer identities
# with. Fails closed: when unset those endpoints return 401 in every NODE_ENV
# (public endpoints keep working). Must match LIVE_ADMIN_TOKEN in the frontend's
# root .env. Production requires at least 32 characters (openssl rand -hex 32).
LIVE_ADMIN_TOKEN=
# Secret for the per-user server-to-server routes (goals, my-data, packs, skins
# ownership, roster opt-in, the osu! proxies, analytics capture), which the
# frontend's server functions call with the osu!-verified viewer id in the
# payload. Blank means "not split yet": those routes accept the admin token,
# which is the old behaviour. Set it to a different value here AND as
# LIVE_BRIDGE_TOKEN in the frontend's root .env in the same deploy - one side
# alone answers 401 to every signed-in feature. Splitting them is what keeps a
# leak of either credential from also being write-as-any-player.
LIVE_BRIDGE_TOKEN=
TRUST_PROXY_HEADERS=false
COUNTRY_WARM_TTL_MS=259200000
PUBLIC_API_RATE_PER_MINUTE=120
PUBLIC_COSTLY_RATE_PER_MINUTE=30
COUNTRY_ACTIVATE_RATE_PER_MINUTE=10
COUNTRY_ACTIVATE_GLOBAL_RATE_PER_MINUTE=120
COUNTRY_ACTIVATE_NEW_PER_HOUR=12
DAN_ESTIMATE_RATE_PER_MINUTE=20
SSE_CONNECT_RATE_PER_MINUTE=30
SSE_MAX_CONNECTIONS_PER_IP=6
SSE_MAX_CONNECTIONS_TOTAL=500
REPLAY_VIDEO_RATE_PER_MINUTE=2
OSU_API_TARGET_PER_MINUTE=45
OSU_API_HARD_PER_MINUTE=60
OSC_JSON_TARGET_PER_MINUTE=30
TOP_PLAY_MARGIN_PP=5
ROSTER_REFRESH_INTERVAL_MS=21600000
ROSTER_RANKING_PAGES=2
ROSTER_SIZE=100
MAPS_REFRESH_INTERVAL_MS=604800000
OSC_BACKFILL_MAX_AGE_MS=86400000
OSC_BACKFILL_PAGE_LIMIT=1000
OSC_BACKFILL_MAX_PAGES=200
RETENTION_INTERVAL_MS=3600000
SCORE_EVENT_RETENTION_DAYS=14
LIVE_EVENT_RETENTION_DAYS=7
DONE_JOB_RETENTION_DAYS=2
API_CALL_LOG_RETENTION_DAYS=7
REPLAY_VIDEO_JOB_RETENTION_DAYS=2
RANK_SNAPSHOT_RETENTION_DAYS=14
# 0 keeps player activity forever; set a positive number of years to prune it.
ACTIVITY_RETENTION_YEARS=0
MAX_LOCAL_DB_BYTES=10737418240
TARGET_LOCAL_DB_BYTES=8589934592
# Separate file so analytics writes never contend with the main DB's WAL.
ANALYTICS_DATABASE_URL=file:./data/mania-hub-analytics.db
# The journal: the SSE event log, the osu! call log and the shared limiter's
# reservations, in their own file for the same reason. Defaults to
# mania-hub-journal.db beside the main database file; every role opens it.
# JOURNAL_DATABASE_URL=file:./data/mania-hub-journal.db
# The serving process's writes queue in JS and go to SQLite as one transaction
# per flush, batching while the previous flush waits on the lock. This adds a
# fixed window (ms) on top; 0 flushes on the next event-loop turn.
SERVE_WRITE_COALESCE_MS=0
# Run those flushes on a dedicated worker thread (compiled dist only) so a busy
# wait on the write lock never parks the event loop. 0 = inline, the old path.
ENABLE_SERVE_WRITE_THREAD=1

# SQLite page cache and mmap window for the main connection, per process.
# These govern exactly ONE connection each: every other connection the process
# opens (the shared rate limiter, the serve-write connection, the analytics DB,
# the WAL checkpointer, the storage-scan thread, the maps snapshot thread) pins
# its own small values in code, because their working sets are nothing like the
# main connection's. That is what makes tuning these per role worthwhile:
# server and worker run as separate units and can differ.
# SQLITE_CACHE_MB is the page cache in MiB (0 leaves SQLite's default).
# SQLITE_MMAP_MB is the memory-mapped window in MiB (0 disables mmap). The
# window is virtual, but the pages it touches are resident: a 256 MiB window
# over a multi-GB database measured ~48 MiB resident for one GLOBAL maps build.
SQLITE_CACHE_MB=64
SQLITE_MMAP_MB=256

# Schema migration vs. a live writer. A deploy restarts the worker while the
# previous process is still serving/writing, so every DDL statement in migrate()
# races it. SQLITE_MIGRATION_BUSY_TIMEOUT_MS is the busy_timeout of the throwaway
# connection migrate() runs on: blocking inside SQLite is far cheaper than losing
# the statement, because a connection that has once returned SQLITE_BUSY cannot
# be reused (its later writes report success and never commit), so migrate()
# answers one by reopening the connection and re-running the whole idempotent
# migration. SQLITE_MIGRATION_TOTAL_BUSY_WAIT_MS bounds how long that may go on:
# it counts only the passes thrown away plus the backoff between them, never a
# slow-but-progressing migration, and when it is spent boot fails loudly so
# systemd retries. Keep it below the server role's schema wait (total + 120s) so
# a worker waiting out contention can never take the serving process down.
SQLITE_MIGRATION_BUSY_TIMEOUT_MS=10000
SQLITE_MIGRATION_TOTAL_BUSY_WAIT_MS=300000

# Replay video (headless-Chrome rendering + export finalization). Off by
# default; enable only in a local environment. When off, the job endpoint,
# worker lanes, and the Playwright import never come into existence.
ENABLE_REPLAY_VIDEO=false
REPLAY_VIDEO_PUBLIC_ORIGIN=http://localhost:7227
REPLAY_VIDEO_WORK_DIR=./data/replay-video-jobs
REPLAY_VIDEO_PUBLIC_ENABLED=false
REPLAY_VIDEO_UPLOAD_MAX_BYTES=629145600
REPLAY_VIDEO_OPTIMIZE=true
REPLAY_VIDEO_OPTIMIZE_CRF=20
REPLAY_VIDEO_OPTIMIZE_PRESET=slow
REPLAY_VIDEO_AUDIO_BITRATE=160k
REPLAY_VIDEO_RENDER_BASE_URL=http://localhost:3000
REPLAY_VIDEO_CHROME_PATH=

# Audio serving budgets. The process keeps prepared audio, hitsound bundles and
# preview clips in memory only while R2 has no public base URL to redirect
# browsers to; set any cache budget to 0 to disable that cache outright.
AUDIO_CACHE_TTL_MS=900000
AUDIO_CACHE_MAX_ENTRIES=12
AUDIO_CACHE_MAX_BYTES=188743680
PREVIEW_AUDIO_CACHE_MAX_ENTRIES=48
HITSOUND_BUNDLE_CACHE_MAX_ENTRIES=6
HITSOUND_BUNDLE_CACHE_MAX_BYTES=104857600
HITSOUND_MAX_TOTAL_BYTES=25165824
# Ceiling for one .osz download. A real tracked mania set (beatmapset 2136400,
# 27 diffs) is 84,661,083 bytes = 80.7 MiB, so anything under ~96 MiB starts
# breaking legitimate sets.
BEATMAP_ARCHIVE_MAX_BYTES=125829120

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Discord bot (HTTP interactions). Set ENABLE_DISCORD_BOT=true plus the
# application id and public key from the Developer Portal to accept slash
# commands. The bot token is required to register commands and to post live
# feeds into channels. DISCORD_DEV_GUILD_ID registers commands to one guild for
# instant testing (global commands can take up to ~1h to propagate).
ENABLE_DISCORD_BOT=false
ENABLE_DISCORD_FEEDS=true
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=
DISCORD_SITE_ORIGIN=https://mania-tracker.com
