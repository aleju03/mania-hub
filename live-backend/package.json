{
  "name": "mania-hub-live-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node ../scripts/prune-onnxruntime-web.mjs || true",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:watch": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "vitest run && tsc -p tsconfig.json",
    "db:sync-from-vps": "node --env-file-if-exists=.env --import tsx src/maintenance/sync-db-from-vps.ts",
    "db:sync-from-vps:dist": "node --env-file-if-exists=.env dist/maintenance/sync-db-from-vps.js",
    "compact:maps-farmed": "node --env-file-if-exists=.env --import tsx src/maintenance/compact-maps-farmed-overlay.ts",
    "compact:maps-farmed:dist": "node --env-file-if-exists=.env dist/maintenance/compact-maps-farmed-overlay.js",
    "compact:storage": "node --max-old-space-size=768 --expose-gc --env-file-if-exists=.env --import tsx src/maintenance/compact-storage.ts",
    "compact:storage:dist": "node --max-old-space-size=768 --expose-gc --env-file-if-exists=.env dist/maintenance/compact-storage.js",
    "backfill:osu-files": "node --env-file-if-exists=.env --import tsx src/maintenance/backfill-beatmap-osu-files.ts",
    "backfill:osu-files:dist": "node --env-file-if-exists=.env dist/maintenance/backfill-beatmap-osu-files.js",
    "backfill:activity-mods": "node --env-file-if-exists=.env --import tsx src/maintenance/backfill-activity-mods.ts",
    "backfill:activity-mods:dist": "node --env-file-if-exists=.env dist/maintenance/backfill-activity-mods.js",
    "export:chart-analysis": "node --env-file-if-exists=.env --import tsx src/maintenance/export-chart-analysis.ts",
    "import:chart-analysis": "node --env-file-if-exists=.env --import tsx src/maintenance/import-chart-analysis.ts",
    "import:chart-analysis:dist": "node --env-file-if-exists=.env dist/maintenance/import-chart-analysis.js",
    "recompute:vibro": "node --env-file-if-exists=.env --import tsx src/maintenance/recompute-vibro.ts",
    "recompute:vibro:dist": "node --env-file-if-exists=.env dist/maintenance/recompute-vibro.js",
    "backtest:farm-helper": "node --env-file-if-exists=.env --import tsx src/maintenance/farm-helper-backtest.ts",
    "smoke:osc": "node --env-file-if-exists=.env --import tsx src/smoke-osc.ts",
    "probe:boot-imports": "node --import tsx src/maintenance/boot-import-probe.ts",
    "bench:farm-helper": "node --env-file-if-exists=.env --import tsx src/maintenance/farm-helper-benchmark.ts",
    "golden:farm-helper": "node --env-file-if-exists=.env --import tsx src/maintenance/farm-helper-golden.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@libsql/client": "^0.17.3",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.27.0",
    "playwright-core": "^1.60.0",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
