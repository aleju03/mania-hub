{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["inspirations", "local-notes", "algorithms"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#dan/*": ["./backend/src/dan/*"],
      "#custom-themes/*": ["./backend/src/custom-themes/*"],
      "#leoblack/*": ["./backend/vendor/leoblack/*"],
      "#replay-judge/*": ["./backend/src/replay-judge/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* Repeat `tsc --noEmit` runs only recheck what changed (a no-change run
       takes seconds instead of ~40). The cache is under node_modules, so it is
       never committed and each worktree keeps its own. */
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/root.tsbuildinfo",

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
